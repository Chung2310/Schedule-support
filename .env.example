# Port Metro
RCT_METRO_PORT=8088
PORT=8088

# Địa chỉ IP LAN máy tính từ lệnh `ipconfig`
REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.17

# Expo Token
EXPO_TOKEN=your_expo_token_here

# Biến môi trường công khai
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_HOST_IP=192.168.1.17
EXPO_PUBLIC_PORT=8088

# URL công khai sau khi bạn host docs/privacy-policy.html (không chứa thông tin bí mật)
EXPO_PUBLIC_PRIVACY_POLICY_URL=
# Trang hỗ trợ HTTPS hoặc mailto:email-hỗ-trợ
EXPO_PUBLIC_SUPPORT_URL=
