{
  "expo": {
    "name": "iGen Check",
    "slug": "schedule",
    "owner": "igen-technology",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logomoi.png",
    "web": {
      "favicon": "./assets/logomoi.png"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.igen.schedule",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Chuyển lời nói thành văn bản để tạo lịch hẹn. Dịch vụ nhận diện của Apple có thể xử lý âm thanh qua mạng.",
        "NSMicrophoneUsageDescription": "Dùng micro khi bạn bấm ghi âm để nhập lịch hẹn bằng giọng nói. Bạn cũng có thể nhập bằng bàn phím.",
        "NSPhotoLibraryUsageDescription": "Thư viện xử lý tệp tích hợp chỉ có thể đọc ảnh khi bạn cho phép. iGen Check không tự thu thập hay tải ảnh lên máy chủ; bạn có thể từ chối quyền này và vẫn quản lý lịch bình thường.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.company.ceovoicecalendar",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6366F1",
          "sounds": [
            "./assets/meeting_reminder.wav"
          ]
        }
      ],
      "expo-sqlite",
      "expo-speech-recognition",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.igen.schedule.widgets",
          "groupIdentifier": "group.com.igen.schedule",
          "enablePushNotifications": false,
          "enableAndroid": false,
          "widgets": [
            {
              "name": "TodayScheduleWidget",
              "displayName": "Lịch hôm nay",
              "description": "Lịch hẹn trong ngày và cuộc hẹn kế tiếp của bạn.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              },
              "android": null
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6b866bf1-af89-481f-840e-c2779ec6c5fb"
      }
    }
  }
}
