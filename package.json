{
  "name": "calender",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.30",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-notifications": "~57.0.23",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "^57.1.1",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --port 8088",
    "android": "expo start --android --port 8088",
    "ios": "expo start --ios --port 8088",
    "web": "expo start --web --port 8088",
    "build:android:test": "npx eas-cli@latest build --platform android --profile preview-device",
    "build:ios": "node scripts/build-ios.cjs",
    "submit:ios": "npx eas-cli@latest submit --platform ios --profile production",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "ios:check": "node scripts/check-ios-config.cjs",
    "test": "node --test",
    "legal:build": "node scripts/build-privacy-policy.cjs"
  },
  "private": true
